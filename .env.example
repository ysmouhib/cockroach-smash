# Copy this file to .env (which git ignores) and fill in your project's values (see docs/SETUP.md).
# Supabase dashboard: Project Settings → API Keys (publishable key) and the Connect button (URL).

# "fake" = in-memory backend, nothing leaves the browser. "supabase" = the real one.
# Leave it out to use Supabase whenever the two values below are set.
VITE_BACKEND=supabase

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The PUBLISHABLE key (starts with sb_publishable_). Never the secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
